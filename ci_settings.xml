<!-- Maven settings for GitLab CI and the Docker image build (HEL-123).

     Maven >= 3.8 ships a default mirror ("maven-default-http-blocker") that
     blocks every non-localhost http repository. The RowRelay registry hop is
     in-cluster plain http (pod -> gitlab service on a single-node cluster —
     the same accepted tradeoff as the datakit deploy). The blocker stays
     ACTIVE for every other external http repository — only the named
     `rowrelay-gitlab` repository id is excluded from it (mirrorOf `!` scoping),
     so no other plaintext repo can slip in through this file. No credentials:
     the rowrelay project is public, package reads are anonymous. -->
<settings xmlns="http://maven.apache.org/SETTINGS/1.1.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.1.0 http://maven.apache.org/xsd/settings-1.1.0.xsd">
  <mirrors>
    <mirror>
      <id>maven-default-http-blocker</id>
      <name>block external http EXCEPT the in-cluster rowrelay registry</name>
      <mirrorOf>external:http:*,!rowrelay-gitlab</mirrorOf>
      <url>http://0.0.0.0/</url>
      <blocked>true</blocked>
    </mirror>
  </mirrors>
</settings>
