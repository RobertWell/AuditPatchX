<!-- Maven settings for GitLab CI and the Docker image build.

     HEL-189: PkgroveKit >=0.3.0 (com.pkgrove) resolves from PUBLIC Maven Central
     over https, so the in-cluster plain-http registry hop — and its blocker
     exemption — is retired. This file now only re-asserts Maven's standard
     full http blocker: every external plaintext-http repository is blocked,
     with NO exceptions. -->
<settings xmlns="http://maven.apache.org/SETTINGS/1.1.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.1.0 http://maven.apache.org/xsd/settings-1.1.0.xsd">
  <mirrors>
    <mirror>
      <id>maven-default-http-blocker</id>
      <name>block every external http repository</name>
      <mirrorOf>external:http:*</mirrorOf>
      <url>http://0.0.0.0/</url>
      <blocked>true</blocked>
    </mirror>
  </mirrors>
</settings>
