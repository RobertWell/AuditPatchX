# DO NOT commit real credentials. This file is a template only.
# Create the real secret outside of source control:
#
#   kubectl create secret generic auditpatchx-secret \
#     --namespace auditpatchx \
#     --from-literal=db-url="jdbc:oracle:thin:@//stock-trading-system-oracle-database.stocktrader.svc.cluster.local:1521/XEPDB1" \
#     --from-literal=db-user="TRDMGMR" \
#     --from-literal=db-password="$DB_PASSWORD"
#
# Or use Vault / External Secrets Operator / Sealed Secrets in production.
apiVersion: v1
kind: Secret
metadata:
  name: auditpatchx-secret
  namespace: auditpatchx
type: Opaque
stringData:
  db-url: "jdbc:oracle:thin:@//CHANGE_ME:1521/XEPDB1"
  db-user: "CHANGE_ME"
  db-password: "CHANGE_ME"
