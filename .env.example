# ── Database ─────────────────────────────────────────────────────────────────
DB_URL=jdbc:oracle:thin:@//localhost:1521/XEPDB1
DB_USER=TRDMGMR
DB_PASSWORD=yourpassword

# ── Server ───────────────────────────────────────────────────────────────────
PORT=8080

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_JSON=false
LOG_CONSOLE_ENABLE=true

# ── External config (ArgoCD / production only) ───────────────────────────────
# Point to a mounted ConfigMap YAML that overrides allowlist and sync-tables.
# Leave empty for local dev (base application.yml is used).
CONFIG_LOCATIONS=
# Example (Kubernetes): CONFIG_LOCATIONS=/app/config/application.yaml
