# ── Database ─────────────────────────────────────────────────────────────────
DB_URL=jdbc:oracle:thin:@//localhost:1521/XEPDB1
DB_USER=TRDMGMR
DB_PASSWORD=yourpassword

# ── Server ───────────────────────────────────────────────────────────────────
PORT=8080

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_JSON=false
LOG_CONSOLE_ENABLE=true

# ── External config (ArgoCD / production only) ───────────────────────────────
# Quarkus reads this env var to load an additional config file.
# In ArgoCD: mount a ConfigMap at /app/config/application.yaml with the
# production allowlist and sync-tables pairs, then set this env var.
# Leave unset for local dev — base application.yml is used.
#
# QUARKUS_CONFIG_LOCATIONS=/app/config/application.yaml
